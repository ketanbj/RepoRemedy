# Optional for public preview if you already ran `gh auth login`.
# Never commit .env. Environment variables take precedence.
GITHUB_TOKEN=

# Only for --mode local-llm: install a local model with `ollama pull llama3`.
OLLAMA_MODEL=llama3
# OLLAMA_URL=http://localhost:11434

# Only for --mode llm: your hosted OpenAI-compatible API.
# LLM_BASE_URL=https://YOUR_PROVIDER/v1
# LLM_MODEL=YOUR_MODEL
# LLM_API_KEY=YOUR_KEY
